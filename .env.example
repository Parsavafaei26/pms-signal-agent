# Copy this file to .env and fill it in. .env is in .gitignore and must never be committed.

# Free local model (Ollama app running on this computer)
OLLAMA_MODEL=
# OLLAMA_HOST=http://localhost:11434

# Paid Anthropic API (optional)
ANTHROPIC_API_KEY=
# Check the exact id with: python3 scripts/live_eval.py --list-models
ANTHROPIC_MODEL=claude-haiku-5-5
